# Non-secret contract for the isolated Adult QA environment.
#
# This file is intentionally safe to commit. Application IDs are populated only
# after the dedicated QA Entra registrations exist. Credentials belong in the
# QA Key Vault or the protected GitHub environment, never here.

PROJECT_SLUG="hinterland"
ENVIRONMENT="adult-qa"
HINTERLAND_RELEASE_LANE="adult_qa"

AZURE_SUBSCRIPTION_ID="3ac5dfb0-91b7-47d3-8187-9dc8d6305e96"
AZURE_TENANT_ID="18dbd7fa-c411-49bc-82fc-9ccaa26e3404"
AZURE_LOCATION="centralus"

HINTERLAND_RESOURCE_GROUP="hinterland-qa-rg"
HINTERLAND_CONTAINER_APPS_ENV="hinterland-cae-qa"
HINTERLAND_CONTAINER_APP_NAME="hinterland-api-qa"
HINTERLAND_USER_ASSIGNED_IDENTITY="hinterland-api-qa-mi"
HINTERLAND_JOBS_USER_ASSIGNED_IDENTITY="hinterland-jobs-qa-mi"
HINTERLAND_KEY_VAULT_NAME="hinterland-kv-qa"
HINTERLAND_STORAGE_ACCOUNT="hinterlandphotosqa"
HINTERLAND_PHOTOS_CONTAINER="qa-photos"
HINTERLAND_TAXONOMY_PACKS_CONTAINER="qa-taxonomy-packs"
HINTERLAND_SERVICE_BUS_NAMESPACE="hinterland-sb-qa"
HINTERLAND_MODERATION_QUEUE="moderation-pending-qa"
HINTERLAND_CONTENT_SAFETY_ACCOUNT="hinterland-content-safety-qa"
HINTERLAND_OPS_ACTION_GROUP="hinterland-ops-qa"
HINTERLAND_PARENT_STATIC_WEB_APP="hinterland-parents-qa-swa"

# These are the only three shared Azure services allowed by ADR 0018.
HINTERLAND_ACR_NAME="hinterlandacrdev"
HINTERLAND_API_IMAGE_REPOSITORY="hinterland-api"
HINTERLAND_LOG_ANALYTICS_WORKSPACE="hinterland-law-dev"
HINTERLAND_SHARED_RESOURCE_GROUP="hinterland-dev-rg"
HINTERLAND_DATABASE_HOST="hinterland-postgres-dev.postgres.database.azure.com"
HINTERLAND_DATABASE_SERVER="hinterland-postgres-dev"

# The server is shared; the database, role, password, migrations, and data are
# not. Never change these to the W1 `hinterland` database or `hadmin` role.
HINTERLAND_DATABASE_NAME="hinterland_qa"
HINTERLAND_DATABASE_USER="hinterland_qa_app"

HINTERLAND_API_DOMAIN="qa-api.thehinterlandguide.app"
HINTERLAND_PARENT_DOMAIN="qa-parents.thehinterlandguide.app"
HINTERLAND_KID_ISSUER="https://qa-api.thehinterlandguide.app"
HINTERLAND_KID_AUDIENCE="hinterland-api-qa"
HINTERLAND_KID_KEY_ID="k1-adult-qa-2026-07"

# Filled after dedicated QA app registrations are created. The preflight
# refuses promotion while either placeholder remains.
HINTERLAND_ENTRA_API_AUDIENCE="REQUIRED_QA_ENTRA_API_APP_ID"
HINTERLAND_ENTRA_CLIENT_APP_ID="REQUIRED_QA_ENTRA_CLIENT_APP_ID"

HINTERLAND_MODERATION_PROVIDER="azure_content_safety"
HINTERLAND_INAT_CV_ENABLED="false"
HINTERLAND_INAT_CV_DISCLOSURE_APPROVED="false"
HINTERLAND_INAT_CV_BENCHMARK_APPROVED="false"
HINTERLAND_INAT_SUBMIT_ENABLED="false"
HINTERLAND_SHARED_GROUPS_ENABLED="false"
HINTERLAND_DEV_AUTH_ENABLED="false"
HINTERLAND_ALLOW_STUB_AUTH="false"
HINTERLAND_OBSERVATION_IDEMPOTENCY_REQUIRED="true"
